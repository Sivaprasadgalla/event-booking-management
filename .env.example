# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/event_booking_marketplace

# JWT Secret for Session Authentication
JWT_SECRET=super_secure_event_booking_secret_key_2026_jwt_token!

# Razorpay Payment Gateway
# You can use standard Razorpay test keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Cloudinary (Optional - curated fallback images are supported)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
